#!/bin/sh
# A small CLI for integration tests: top-level help listing subcommands,
# per-subcommand help, and a --version line -- what the crawler walks --
# and a completion generator, as clap and cobra tools have.
case "$1" in
--version)
    echo "faketool 2.3.1"
    ;;
--help | -h | "")
    cat <<'EOF'
Usage: faketool [OPTIONS] COMMAND [ARGS]...

Build and serve fake projects.

Commands:
  build       Build the project
  serve       Serve the last build
  completion  Print a shell completion script

Options:
  -v, --verbose       Print every step
      --color <WHEN>  Colour output [possible values: auto, always, never]
      --version       Print the version and exit
  -h, --help          Print help and exit
EOF
    ;;
build)
    cat <<'EOF'
Usage: faketool build [OPTIONS] [PATH]

Build the project

Options:
      --release   Optimise the build
  -j, --jobs <N>  Parallel jobs [default: 4]
  -h, --help      Print help
EOF
    ;;
serve)
    cat <<'EOF'
Usage: faketool serve [OPTIONS]

Serve the last build

Options:
      --port <PORT>      Listen port [default: 8080]
      --format <FORMAT>  Log format [possible values: text, json]
  -h, --help             Print help
EOF
    ;;
completion)
    case "$2" in
    bash) echo "complete -W 'build serve completion' faketool" ;;
    zsh) printf '#compdef faketool\n_arguments "1: :(build serve completion)"\n' ;;
    fish) echo "complete -c faketool -f -a 'build serve completion'" ;;
    *)
        cat <<'USAGE'
Usage: faketool completion <SHELL>

Print a shell completion script

Arguments:
  <SHELL>  [possible values: bash, zsh, fish]
USAGE
        ;;
    esac
    ;;
*)
    echo "error: unrecognized subcommand '$1'" >&2
    exit 2
    ;;
esac

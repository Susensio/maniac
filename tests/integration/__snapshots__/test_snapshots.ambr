  [exit 0]
                          Pages maniac installed
  ┏━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━┳━━━━━━━━━━━┓
  ┃ Tool     ┃ State     ┃ Documents      ┃ Installed      ┃ Source    ┃
  ┡━━━━━━━━━━╇━━━━━━━━━━━╇━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━╇━━━━━━━━━━━┩
  │ faketool │ ok        │ faketool 2.3.1 │ faketool 2.3.1 │ generated │
